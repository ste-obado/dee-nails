# Used by docker-compose.yml — copy to .env and fill in real values.
# The backend container also reads these (DATABASE_URL/REDIS_HOST are
# overridden inside docker-compose.yml itself to point at the other
# containers by service name).

MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_too

SECRET_KEY=generate_a_long_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

ENVIRONMENT=production
# the booking site and the admin site (comma-separated, no trailing slash)
FRONTEND_ORIGINS=https://deenails.example,https://admin.deenails.example

# Dee Nails
SALON_NAME=Dee Nails
# Digits only, international format, no "+": e.g. 254712345678. Seeds the
# setting the first time; Dee can change it later from the admin panel.
WHATSAPP_NUMBER=254702839214
SALON_UTC_OFFSET_HOURS=3
MAX_UPCOMING_BOOKINGS_PER_PHONE=3
